---
interface Props {
  title: string;
  url: string;
}
const { title, url } = Astro.props as Props;
import { getIconHtml } from "../../utils/IconHelper.ts"

const buttonIcons = [
  {
    alt: "Open LinkedIn",
    url: "https://www.linkedin.com/in/bei-kuan-teo-8b0976339/",
    icon: "linkedin"
  },
  {
    alt: "Open GitHub",
    url: "https://github.com/PremierofPotatoes",
    icon: "github"
  },
]
---

<div class="sw-share group flex items-center gap-4">
  {buttonIcons.map((p) => {
      const iconResult = getIconHtml(p.icon);
      
      return (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="group text-[color:var(--color-text-secondary)]" aria-label=`{p.alt}` set:html={iconResult.html} />
      )
    })}
</div>
