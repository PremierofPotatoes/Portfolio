---
interface Props {
  title: string;
  url: string;
}
const { title, url } = Astro.props as Props;
const liUrl = "https://www.linkedin.com/in/bei-kuan-teo-8b0976339/"

import liIcon from '../../../assets/icons/linkedin-blog-post-shareicon.svg?raw';
---

<div class="sw-share group flex items-center gap-2">
  <a href={liUrl} target="_blank" rel="noopener noreferrer" class="sw-share-btn" aria-label="Share on LinkedIn" set:html={liIcon} />
</div>
